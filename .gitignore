# Ignore local .terraform cache directories
**/.terraform/
.terraform/

# Ignore state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Ignore secrets and logs
*.tfvars
*.tfvars.json
*.crash.log
override.tf
override.tf.json

# Allow environment tfvars templates (no secrets — sensitive values via TF_VAR_* env vars)
!01-Infrastructure/environments/dev/dev.tfvars
!01-Infrastructure/environments/prod/prod.tfvars
!08-Monitoring/monitoring.tfvars

# Rendered K8s manifests (deploy script fills placeholders into these temp
# files per-region; the source .yaml keeps its <PLACEHOLDER> tokens).
**/*.rendered.yaml
