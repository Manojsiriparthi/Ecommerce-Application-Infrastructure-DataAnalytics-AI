generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Payment { id String @id @default(uuid()); transactionId String @unique; userId String; amount Decimal @db.Decimal(12,2); currency String @default("INR"); status String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
