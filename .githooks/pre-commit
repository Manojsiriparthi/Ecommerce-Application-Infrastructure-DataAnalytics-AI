#!/usr/bin/env bash

set -euo pipefail

echo "======================================"
echo "     PRE-COMMIT QUALITY & SECURITY"
echo "======================================"

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
    echo "No staged files."
    exit 0
fi

FAILED=0

# ==========================================================
# 1. SECURITY — BLOCK SECRET / CREDENTIAL FILES
# ==========================================================

echo
echo "[1/3] Checking sensitive files..."

while IFS= read -r file; do
    case "$file" in
        .env|.env.*|*/.env|*/.env.*)
            if [[ "$file" != *.env.example ]]; then
                echo "ERROR: Secret environment file detected: $file"
                FAILED=1
            fi
            ;;
        *.pem|*.key|*.p12|*.pfx|*.jks)
            echo "ERROR: Private/certificate credential file detected: $file"
            FAILED=1
            ;;
        */credentials|*/credentials.*|credentials|credentials.*)
            echo "ERROR: Credential file detected: $file"
            FAILED=1
            ;;
    esac
done <<< "$STAGED_FILES"

if [ "$FAILED" -eq 1 ]; then
    echo
    echo "Security check FAILED."
    exit 1
fi

echo "PASS: No prohibited credential files staged."

# ==========================================================
# 2. SECURITY — SECRET PATTERN SCAN
# ==========================================================

echo
echo "[2/3] Scanning staged content for secrets..."

DIFF_CONTENT="$(git diff --cached --unified=0)"

SECRET_PATTERN='AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|aws_secret_access_key[[:space:]]*[:=]|aws_access_key_id[[:space:]]*[:=]|BEGIN[[:space:]]+(RSA|EC|OPENSSH|DSA)[[:space:]]+PRIVATE KEY|github_pat_[A-Za-z0-9_]+|ghp_[A-Za-z0-9]+|password[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']+["'\'']|api[_-]?key[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']+["'\'']|secret[_-]?key[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']+["'\'']'

if echo "$DIFF_CONTENT" | grep -Eiq "$SECRET_PATTERN"; then
    echo "ERROR: Possible credential/secret detected in staged changes."
    echo "Commit blocked."
    FAILED=1
else
    echo "PASS: No obvious secrets detected."
fi

if [ "$FAILED" -eq 1 ]; then
    exit 1
fi

# ==========================================================
# 3. CHANGED-FILE VALIDATION
# ==========================================================

echo
echo "[3/3] Running changed-file validation..."

while IFS= read -r file; do

    # Skip deleted files
    [ -f "$file" ] || continue

    case "$file" in

        # --------------------------
        # YAML
        # --------------------------
        *.yml|*.yaml)
            if command -v yamllint >/dev/null 2>&1; then
                echo "YAML: $file"
                yamllint "$file" || FAILED=1
            else
                echo "WARNING: yamllint not installed — skipped $file"
            fi
            ;;

        # --------------------------
        # JSON
        # --------------------------
        *.json)
            echo "JSON: $file"
            if ! python3 -m json.tool "$file" >/dev/null 2>&1; then
                echo "ERROR: Invalid JSON: $file"
                FAILED=1
            fi
            ;;

        # --------------------------
        # Python
        # --------------------------
        *.py)
            echo "Python: $file"
            if ! python3 -m py_compile "$file"; then
                FAILED=1
            fi
            ;;

        # --------------------------
        # Shell
        # --------------------------
        *.sh)
            echo "Shell: $file"
            if command -v shellcheck >/dev/null 2>&1; then
                shellcheck "$file" || FAILED=1
            else
                echo "WARNING: shellcheck not installed — skipped $file"
            fi
            ;;

        # --------------------------
        # Terraform
        # --------------------------
        *.tf)
            echo "Terraform: $file"
            if command -v terraform >/dev/null 2>&1; then
                terraform fmt -check "$file" || FAILED=1
            else
                echo "WARNING: terraform not installed — skipped $file"
            fi
            ;;

        # --------------------------
        # JavaScript / TypeScript
        # --------------------------
        *.js|*.jsx|*.ts|*.tsx)
            echo "JS/TS: $file"

            # Basic syntax validation where Node can parse the file.
            if [[ "$file" == *.js || "$file" == *.jsx ]]; then
                node --check "$file" 2>/dev/null || {
                    echo "ERROR: JavaScript syntax error: $file"
                    FAILED=1
                }
            fi
            ;;

    esac

done <<< "$STAGED_FILES"

if [ "$FAILED" -ne 0 ]; then
    echo
    echo "======================================"
    echo " PRE-COMMIT CHECKS FAILED"
    echo " Commit blocked."
    echo "======================================"
    exit 1
fi

echo
echo "======================================"
echo " PRE-COMMIT CHECKS PASSED"
echo " Commit allowed."
echo "======================================"
